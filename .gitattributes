# Normalize all text files to LF in the repo and working tree.
* text=auto eol=lf

# Scripts must stay LF so they run on Linux.
*.sh text eol=lf

# Binary assets: never normalize or diff as text.
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.mp4   binary
*.webm  binary
*.mkv   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.db    binary
*.sqlite binary
