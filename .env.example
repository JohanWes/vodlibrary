# Server configuration
PORT=8000
HOST_IP=localhost
BASE_PATH=

# Library paths (inside container) - comma-separated list of directories
VIDEO_LIBRARY=/videos,/home/clips

# Thumbnail and preview settings
THUMBNAIL_TIME=5
THUMBNAIL_CACHE_DIR=/app/data/thumbnails
PREVIEW_DURATION=5
PREVIEWS_CACHE_DIR=/app/data/previews

# Database settings
DB_DIR=/app/data/db

# Application settings
VODS_NAME=VODlibrary
# Password/session settings
# Secret used to sign session cookies (high-entropy; required when ENABLE_AUTH=true)
SESSION_SECRET=
# Password required to log in (leave empty to disable authentication)
SESSION_KEY=

# Enable/disable authentication (true/false). If false, site is public.
ENABLE_AUTH=true
# Set true when the public site is HTTPS, including behind a TLS reverse proxy
AUTH_COOKIE_SECURE=false

# Maximum concurrent live-update connections
SSE_MAX_CLIENTS=100


# Secret used to sign scoped share tokens (high-entropy)
SHARE_TOKEN_SECRET=

# Server-side caching settings
# Maximum cache size in MB (default: 500)
CACHE_MAX_SIZE=500
# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600
# Threshold for considering a video "popular" (access count)
CACHE_POPULARITY_THRESHOLD=5
# Maximum number of segments to cache per video
CACHE_MAX_SEGMENTS_PER_VIDEO=3

# CDN configuration
# Enable/disable CDN integration
CDN_ENABLED=false
# CDN provider (supported: 'custom', 'cloudflare', 'bunny', 'keycdn')
CDN_PROVIDER=custom
# CDN base URL (for custom provider)
CDN_BASE_URL=https://cdn.example.com
# CDN token (if required by provider)
CDN_TOKEN=
# CDN region (if applicable)
CDN_REGION=auto
# Enable/disable signed URLs
CDN_SIGNED_URLS=false
# Secret key for signed URLs
CDN_SIGNED_URLS_SECRET=

# Advanced Search with LLM
# Enable/disable advanced search feature
ADVANCED_SEARCH_ENABLED=false
# OpenRouter API key for LLM integration
OPENROUTER_API_KEY=
# OpenRouter model to use for advanced search
OPENROUTER_MODEL=deepseek/deepseek-r1-0528
