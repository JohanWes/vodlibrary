# VODlibrary configuration. Copy to .env and edit. Values shown are the code
# defaults unless noted. Relative paths resolve from the directory the server
# is started in (the repo root when using npm start / scripts/start_server.sh).

# --- Server ---
# HTTP port (default: 8005)
PORT=8005
# Bind address (default: localhost)
HOST_IP=localhost
# URL prefix when served under a sub-path behind a reverse proxy, e.g. /vod (default: empty)
BASE_PATH=
# Site name, used verbatim in page titles, header and share previews (default: VODlibrary)
VODS_NAME=VODlibrary
# Log verbosity: set to debug for verbose logs (default: info)
LOG_LEVEL=info
# Proxies trusted to set X-Forwarded-For (the login throttle keys on the client IP):
# true, false, a hop count, or an Express trust list such as "loopback, 10.0.0.0/8".
# The default fits a reverse proxy (Caddy) on the same host (default: loopback)
TRUST_PROXY=loopback
# Send the Content-Security-Policy as Report-Only instead of enforcing it (default: false)
CSP_REPORT_ONLY=false

# --- Library ---
# Comma-separated list of video directories (required; no default, nothing is scanned without it)
VIDEO_LIBRARY=/path/to/videos,/path/to/more/videos
# Max files processed in parallel by the file watcher (default: 2)
WATCHER_CONCURRENCY=2
# Debounce for file watcher events in ms (default: 500)
WATCHER_DEBOUNCE_MS=500

# --- Thumbnails and hover previews ---
# Whole seconds into the video to capture the thumbnail (default: 5)
THUMBNAIL_TIME=5
# Timeout in seconds for each ffprobe and thumbnail ffmpeg run (default: 60)
THUMBNAIL_TIMEOUT_SECONDS=60
# Thumbnail output directory (default: ./public/thumbnails)
THUMBNAIL_CACHE_DIR=./public/thumbnails
# Set to false to skip hover preview generation (default: enabled)
ENABLE_PREVIEWS=true
# Preview clip length in seconds (default: 10)
PREVIEW_DURATION=10
# Preview output directory (default: ./public/previews)
PREVIEWS_CACHE_DIR=./public/previews
# Preview preset (default: card):
#   card    640 px H.264, <= 700 kbps, <= 30 fps (sized for the library cards)
#   low     480 px H.264
#   medium  720 px SVT-AV1, high 1080 px SVT-AV1, amd_av1 1080 px AMF AV1 (fall back to H.264)
PREVIEW_QUALITY=card
# Max concurrent preview encodes (default: 2)
PREVIEW_MAX_CONCURRENT=2
# Timeout in seconds for one preview encode (default: 300)
PREVIEW_TIMEOUT_SECONDS=300
# Failed preview encodes are retried up to this many times per version of a file (default: 2)
PREVIEW_MAX_ATTEMPTS=2
# CPU niceness 0-19 for ffmpeg/ffprobe children (default: 10)
FFMPEG_NICENESS=10
# ffmpeg / ffprobe binaries (default: ffmpeg / ffprobe from PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Database ---
# SQLite database directory (default: ./data/db)
DB_DIR=./data/db

# --- Authentication and sharing ---
# Require login (default: false). When true, SESSION_KEY and SESSION_SECRET are required
# or every protected request returns 500. 5 failed logins in 15 minutes lock that
# IPv4 address or IPv6 /64 out for 15 minutes.
ENABLE_AUTH=true
# Password required to log in
SESSION_KEY=
# High-entropy secret used to sign session cookies
SESSION_SECRET=
# High-entropy secret used to sign scoped share tokens (required for share links when auth is on)
SHARE_TOKEN_SECRET=
# Public http(s) origin used to build share links, e.g. https://vods.example.com (no default).
# Required: without a valid value, creating a share link returns HTTP 500.
SHARE_BASE_URL=
# Mark auth/share cookies Secure; set true when the public site is HTTPS (default: false)
AUTH_COOKIE_SECURE=false
# Maximum concurrent live-update (SSE) connections (default: 100)
SSE_MAX_CLIENTS=100

# --- CDN ---
# Redirect video streams to the CDN; ignored when ENABLE_AUTH=true. The CDN
# origin is added to the CSP media-src (default: false)
CDN_ENABLED=false
# Provider: custom, cloudflare, bunny, keycdn (default: custom)
CDN_PROVIDER=custom
# CDN base URL, may include a path such as https://x.b-cdn.net/vods (default: empty)
CDN_BASE_URL=https://cdn.example.com
# bunny: the token-authentication key used to sign URLs (default: empty)
CDN_TOKEN=
# custom provider: add an HMAC expires/signature query (default: false)
CDN_SIGNED_URLS=false
# Secret for signed CDN URLs (default: empty)
CDN_SIGNED_URLS_SECRET=

# --- LLM-powered advanced search (OpenRouter) ---
# Enable advanced search; results are cached per query for 10 minutes (default: false)
ADVANCED_SEARCH_ENABLED=false
# OpenRouter API key
OPENROUTER_API_KEY=
# OpenRouter model id (code default: google/gemini-2.5-flash-preview-05-20:thinking)
OPENROUTER_MODEL=deepseek/deepseek-r1-0528
